NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database — three roles, see scripts/postgres-init.sql
# DATABASE_URL: ledgera_app (RLS-restricted) — normal per-request API traffic
# DATABASE_ADMIN_URL: ledgera_bypass (BYPASSRLS) — pre-auth/webhook/super_admin only
# DATABASE_MIGRATOR_URL: ledgera (schema owner) — migrations only
DATABASE_URL=postgres://ledgera_app:ledgera_app_dev@localhost:5432/ledgera_dev
DATABASE_ADMIN_URL=postgres://ledgera_bypass:ledgera_bypass_dev@localhost:5432/ledgera_dev
DATABASE_MIGRATOR_URL=postgres://ledgera:ledgera_dev@localhost:5432/ledgera_dev

# Deployment mode: saas (subscription-enforced, multi-tenant) | dedicated
# (single-tenant, billed by contract — see docs/runbooks/provision-dedicated-instance.md)
DEPLOYMENT_MODE=saas

# Redis
REDIS_URL=redis://:ledgera_redis_dev@localhost:6379

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_RS256_IN_PROD
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Monime.io — Sierra Leone mobile money payments
# Get keys from https://dashboard.monime.io → Settings → API Keys
MONIME_API_KEY=
MONIME_WEBHOOK_SECRET=
MONIME_ENV=sandbox

# Email (Mailpit for dev, configure SMTP for prod)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ledgera.app

# Storage (local for dev, S3 in prod)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# AWS S3 (production)
AWS_REGION=af-south-1
AWS_S3_BUCKET=ledgera-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
